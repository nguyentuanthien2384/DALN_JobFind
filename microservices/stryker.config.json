{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing for gateway auth/limits, access control and offer/interview validation. Run with npm run test:mutation (incremental) or test:mutation:full.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "configFile": "stryker.vitest.config.js" },
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "coverageAnalysis": "perTest",
  "mutate": [
    "shared/accessControl.js",
    "shared/securityConfig.js",
    "api-gateway/src/middlewares/auth.js",
    "api-gateway/src/middlewares/rateLimit.js",
    "job-core-service/src/libs/postingQuota.js",
    "application-service/src/libs/offer.js",
    "application-service/src/libs/interview.js"
  ],
  "ignorePatterns": ["coverage", "reports", "*.log", "docs", "ops", "scripts/compose-acceptance"],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 92, "low": 85, "break": 85 },
  "concurrency": 4,
  "timeoutMS": 10000,
  "tempDirName": ".stryker-tmp"
}
