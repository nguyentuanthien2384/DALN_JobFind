{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "decisionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$"
    },
    "jobId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    },
    "recipientId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    },
    "jobTitle": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "companyName": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "decisionId",
    "jobId",
    "recipientId",
    "jobTitle",
    "companyName"
  ],
  "additionalProperties": true,
  "title": "notification.job_approved_requested payload v1",
  "examples": [
    {
      "decisionId": "11111111-1111-4111-8111-111111111111",
      "jobId": 7,
      "recipientId": 9,
      "jobTitle": "Developer",
      "companyName": "Example"
    }
  ]
}
