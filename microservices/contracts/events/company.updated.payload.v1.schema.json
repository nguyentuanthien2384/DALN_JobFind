{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "companyId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    },
    "companyStatusCode": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "companyCensorCode": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "companyId"
  ],
  "additionalProperties": true,
  "title": "company.updated payload v1",
  "examples": [
    {
      "companyId": 3,
      "companyStatusCode": "S1",
      "companyCensorCode": "CS1"
    }
  ]
}
