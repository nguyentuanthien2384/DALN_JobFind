{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,15}$",
              "format": "jobfind-id"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "statusCode": {
          "enum": [
            "PS1",
            "PS2",
            "PS3",
            "PS4"
          ]
        },
        "descriptionHTML": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "descriptionMarkdown": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "userId": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,15}$",
                  "format": "jobfind-id"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "companyId": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,15}$",
                  "format": "jobfind-id"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "companyName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "companyLogo": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 52428800
            },
            {
              "type": "null"
            }
          ]
        },
        "companyStatusCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "companyCensorCode": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "timePost": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "timeEnd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "maxLength": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "isHot": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                0,
                1
              ]
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "statusCode"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "job"
  ],
  "additionalProperties": true,
  "title": "job.created payload v1",
  "examples": [
    {
      "job": {
        "id": 7,
        "name": "Developer",
        "statusCode": "PS3",
        "companyId": 3,
        "companyName": "Example"
      }
    }
  ]
}
