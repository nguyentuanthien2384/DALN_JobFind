{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "applicationId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    },
    "candidateId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    },
    "candidateEmail": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateName": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "jobId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    },
    "jobTitle": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "companyId": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,15}$",
              "format": "jobfind-id"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "companyName": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "fromStage": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "moi_ung_tuyen",
            "dang_xem_xet",
            "phong_van",
            "de_nghi",
            "nhan_viec",
            "tu_choi"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "toStage": {
      "type": "string",
      "enum": [
        "moi_ung_tuyen",
        "dang_xem_xet",
        "phong_van",
        "de_nghi",
        "nhan_viec",
        "tu_choi"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "decision": {
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "message": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "offer": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "companyName": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "\\S"
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "startTime": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "timeZone": {
          "const": "Asia/Ho_Chi_Minh"
        },
        "responseDeadline": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "workMode": {
          "enum": [
            "onsite",
            "remote",
            "hybrid"
          ]
        },
        "location": {
          "type": "string",
          "maxLength": 1000
        },
        "meetingUrl": {
          "type": "string",
          "maxLength": 2000
        },
        "contactName": {
          "type": "string",
          "maxLength": 150,
          "minLength": 1,
          "pattern": "\\S"
        },
        "contactEmail": {
          "type": "string",
          "maxLength": 254,
          "minLength": 1,
          "pattern": "\\S",
          "format": "email"
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 50
        },
        "workSchedule": {
          "type": "string",
          "maxLength": 500
        },
        "salary": {
          "type": "string",
          "maxLength": 1000
        },
        "probation": {
          "type": "string",
          "maxLength": 1000
        },
        "benefits": {
          "type": "string",
          "maxLength": 3000
        },
        "requiredDocuments": {
          "type": "string",
          "maxLength": 3000
        },
        "onboardingInstructions": {
          "type": "string",
          "maxLength": 3000
        }
      },
      "required": [
        "companyName",
        "startDate",
        "startTime",
        "timeZone",
        "responseDeadline",
        "workMode",
        "contactName",
        "contactEmail"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "workMode": {
                "enum": [
                  "onsite",
                  "hybrid"
                ]
              }
            }
          },
          "then": {
            "required": [
              "location"
            ],
            "properties": {
              "location": {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workMode": {
                "const": "remote"
              }
            }
          },
          "then": {
            "required": [
              "meetingUrl"
            ],
            "properties": {
              "meetingUrl": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "applicationId",
    "candidateId",
    "jobId",
    "decision",
    "toStage"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "accepted"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "toStage": {
            "enum": [
              "de_nghi",
              "nhan_viec"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "toStage": {
            "const": "tu_choi"
          }
        }
      }
    }
  ],
  "title": "application.decision_email_requested payload v1",
  "examples": [
    {
      "jobId": 7,
      "candidateId": 9,
      "candidateName": "Ứng viên mẫu",
      "candidateEmail": "candidate@example.invalid",
      "jobTitle": "Developer",
      "applicationId": 31,
      "companyId": 3,
      "fromStage": null,
      "toStage": "nhan_viec",
      "decision": "accepted",
      "message": "Congratulations"
    }
  ]
}
