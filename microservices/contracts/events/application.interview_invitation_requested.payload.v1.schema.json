{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "applicationId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    },
    "candidateId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    },
    "candidateEmail": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "candidateName": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "jobId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    },
    "jobTitle": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "companyId": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,15}$",
              "format": "jobfind-id"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "companyName": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "fromStage": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "moi_ung_tuyen",
            "dang_xem_xet",
            "phong_van",
            "de_nghi",
            "nhan_viec",
            "tu_choi"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "toStage": {
      "const": "phong_van"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000000
        },
        {
          "type": "null"
        }
      ]
    },
    "interview": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "companyName": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1,
          "pattern": "\\S"
        },
        "interviewDate": {
          "type": "string",
          "format": "date"
        },
        "interviewTime": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "durationMinutes": {
          "type": "string",
          "pattern": "^[1-9][0-9]{1,2}$"
        },
        "timeZone": {
          "const": "Asia/Ho_Chi_Minh"
        },
        "interviewMode": {
          "enum": [
            "onsite",
            "online",
            "phone"
          ]
        },
        "location": {
          "type": "string",
          "maxLength": 1000
        },
        "meetingUrl": {
          "type": "string",
          "maxLength": 2000
        },
        "round": {
          "type": "string",
          "maxLength": 150
        },
        "interviewers": {
          "type": "string",
          "maxLength": 500
        },
        "preparation": {
          "type": "string",
          "maxLength": 3000
        },
        "contactName": {
          "type": "string",
          "maxLength": 150,
          "minLength": 1,
          "pattern": "\\S"
        },
        "contactEmail": {
          "type": "string",
          "maxLength": 254,
          "minLength": 1,
          "pattern": "\\S",
          "format": "email"
        },
        "contactPhone": {
          "type": "string",
          "maxLength": 50
        },
        "confirmBy": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      },
      "required": [
        "companyName",
        "interviewDate",
        "interviewTime",
        "timeZone",
        "interviewMode",
        "contactName",
        "contactEmail"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "interviewMode": {
                "const": "onsite"
              }
            }
          },
          "then": {
            "required": [
              "location"
            ],
            "properties": {
              "location": {
                "type": "string",
                "maxLength": 1000,
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interviewMode": {
                "const": "online"
              }
            }
          },
          "then": {
            "required": [
              "meetingUrl"
            ],
            "properties": {
              "meetingUrl": {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interviewMode": {
                "const": "phone"
              }
            }
          },
          "then": {
            "required": [
              "contactPhone"
            ],
            "properties": {
              "contactPhone": {
                "type": "string",
                "maxLength": 50,
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "applicationId",
    "candidateId",
    "jobId",
    "toStage",
    "interview"
  ],
  "additionalProperties": true,
  "title": "application.interview_invitation_requested payload v1",
  "examples": [
    {
      "jobId": 7,
      "candidateId": 9,
      "candidateName": "Ứng viên mẫu",
      "candidateEmail": "candidate@example.invalid",
      "jobTitle": "Developer",
      "applicationId": 31,
      "companyId": 3,
      "companyName": "Example",
      "fromStage": "dang_xem_xet",
      "toStage": "phong_van",
      "message": "Synthetic note",
      "interview": {
        "companyName": "Example",
        "interviewDate": "2099-10-15",
        "interviewTime": "09:00",
        "durationMinutes": "60",
        "timeZone": "Asia/Ho_Chi_Minh",
        "interviewMode": "online",
        "meetingUrl": "https://meet.example.invalid/room",
        "contactName": "HR",
        "contactEmail": "hr@example.invalid"
      }
    }
  ]
}
