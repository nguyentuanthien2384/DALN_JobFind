{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    },
    "taskId": {
      "type": "null"
    },
    "name": {
      "type": "string",
      "maxLength": 1000000
    },
    "descriptionHTML": {
      "type": "string",
      "maxLength": 1000000
    },
    "moderationRequestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-(?:[a-f0-9]{4}-){3}[a-f0-9]{12}$"
    }
  },
  "required": [
    "jobId",
    "name",
    "descriptionHTML",
    "moderationRequestId"
  ],
  "additionalProperties": true,
  "title": "ai.moderate_job payload v1",
  "examples": [
    {
      "jobId": 7,
      "name": "Developer",
      "descriptionHTML": "<p>Build services</p>",
      "moderationRequestId": "11111111-1111-4111-8111-111111111111"
    }
  ]
}
