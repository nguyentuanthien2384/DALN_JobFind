{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,15}$",
          "format": "jobfind-id"
        }
      ]
    }
  },
  "required": [
    "jobId"
  ],
  "additionalProperties": true,
  "title": "job.deleted payload v1",
  "examples": [
    {
      "jobId": 7
    }
  ]
}
