{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$",
      "maxLength": 64
    },
    "jobId": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,15}$",
              "format": "jobfind-id"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceText": {
      "type": "string",
      "maxLength": 20000,
      "minLength": 1,
      "pattern": "\\S"
    },
    "language": {
      "enum": [
        "vi",
        "en"
      ]
    },
    "jobTitle": {
      "type": "string",
      "maxLength": 255
    },
    "jobDescription": {
      "type": "string",
      "maxLength": 200000
    }
  },
  "required": [
    "taskId",
    "sourceText",
    "language"
  ],
  "additionalProperties": true,
  "title": "ai.generate_cv payload v1",
  "examples": [
    {
      "taskId": "task-1",
      "sourceText": "Lan, kỹ sư phần mềm, kỹ năng Node.js và React.",
      "language": "vi"
    }
  ]
}
