# Optional AI Worker configuration
# Anthropic-compatible gateway root; both services call /v1/messages.
# For the purchased gateway: https://1gw.gwai.cloud
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
# The purchased gateway lists opus-5, sonnet-5 and haiku-4-5.
CLAUDE_MODEL=claude-opus-5
AI_CONCURRENCY=2

# Existing XAMPP MySQL/MariaDB database
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3333
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jobfindtest

# Must match backend/JWT_SECRET.
JWT_SECRET=
JWT_ISSUER=jobfind-auth
JWT_AUDIENCE=jobfind-api
JWT_ACCESS_TTL_SECONDS=900
RABBITMQ_USER=jobportal
RABBITMQ_PASSWORD=
POSTGRES_USER=jobportal
POSTGRES_PASSWORD=

# Legacy backend and frontend
LEGACY_URL=http://host.docker.internal:5000
CORS_ORIGIN=http://localhost:3000
# Public frontend origin used by buttons inside notification emails.
FRONTEND_URL=http://localhost:3000
# Leave empty when Gateway is exposed directly. Otherwise list only trusted proxy IPs/CIDRs.
TRUST_PROXY=

# Must match backend/INTERNAL_SECRET.
INTERNAL_SECRET=replace-with-the-same-shared-internal-secret-as-backend

# AI support service, Node >=22. Keys stay on the server.
SUPPORT_CHAT_URL=http://support-chat-service:4008
# The same gateway key can serve the AI Worker and the support chatbot.
# The chatbot tries Claude first when this key is set.
SUPPORT_CLAUDE_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
SUPPORT_OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Enable only for a Gemini project with the appropriate paid data policy.
SUPPORT_GEMINI_PAID=false
# Optional trusted Ollama OpenAI-compatible origin, e.g. http://host.docker.internal:11434/v1
SUPPORT_OLLAMA_URL=
SUPPORT_OLLAMA_MODEL=
SUPPORT_RETENTION_DAYS=30
# Local setup may create the two additive support tables automatically.
# Production: run npm run migrate -w support-chat-service with a migration account, set false.
SUPPORT_AUTO_MIGRATE=true

# Optional email delivery
NODE_ENV=development
EMAIL_APP=
EMAIL_APP_PASSWORD=
# Optional local/demo inbox. Placeholder recipients are redirected here.
# When omitted in development, EMAIL_APP is used as the safe demo inbox.
EMAIL_DEMO_RECIPIENT=

# Keep in sync with backend. Once false, JWTs without a session ID stop working.
AUTH_ALLOW_LEGACY_TOKENS=false
