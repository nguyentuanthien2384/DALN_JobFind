{
  "name": "ai-job-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "He thong microservices cho AI Job Portal",
  "workspaces": [
    "shared",
    "api-gateway",
    "job-core-service",
    "search-service",
    "identity-service",
    "ai-worker",
    "application-service",
    "notification-service",
    "admin-service",
    "support-chat-service"
  ],
  "scripts": {
    "test:support": "vitest run tests/support-service.test.js tests/support-chat-proxy.test.js tests/support-store.test.js",
    "test:support:integration": "node scripts/test-support-chat.mjs",
    "test:support:browser": "node scripts/test-support-chat.mjs --browser",
    "test:support:live": "node scripts/evaluate-support-chat.mjs",
    "test:support:live:fixtures": "node scripts/evaluate-support-fixtures.mjs",
    "test:support:live:browser": "node scripts/test-support-live-browser.mjs",
    "test:ai:live": "node scripts/test-ai-live.mjs",
    "test:support:image": "node scripts/test-support-image.mjs",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "ps": "docker compose ps",
    "test:smoke": "node scripts/smoke-test.js",
    "contracts:generate": "node scripts/http-contracts.mjs && node scripts/event-contracts.mjs",
    "contracts:check": "node scripts/http-contracts.mjs --check && node scripts/event-contracts.mjs --check",
    "local:prepare": "node scripts/prepare-local.mjs",
    "local:preflight": "node scripts/check-rollout.mjs",
    "local:up": "docker compose -f docker-compose.yml -f compose.local.yml --profile monitoring up -d --build",
    "local:ps": "docker compose -f docker-compose.yml -f compose.local.yml --profile monitoring ps",
    "test:image": "node scripts/test-image.mjs",
    "test:compose-background:integration": "node scripts/test-compose-background.mjs",
    "test:compose-browser:integration": "node scripts/test-compose-background.mjs --browser",
    "test:candidate-browser:integration": "node scripts/test-candidate-browser.mjs",
    "test:application-sync:integration": "node scripts/test-application-sync.mjs",
    "test:admin-audit:integration": "node scripts/test-admin-audit.mjs",
    "test:worker-admin:rehearsal": "node scripts/rehearse-worker-admin.mjs",
    "test:search-projection:integration": "node scripts/test-search-projection.mjs",
    "test:ai-tasks:integration": "node scripts/test-ai-tasks.mjs",
    "test:ai-results:integration": "node scripts/test-ai-results.mjs",
    "test:ai-requests:integration": "node scripts/test-ai-requests.mjs",
    "test:event-contracts:integration": "node scripts/test-event-contracts.mjs",
    "test:posting-quota:integration": "node scripts/test-posting-quota.mjs",
    "test:job-writes:integration": "node scripts/test-posting-quota.mjs",
    "test:job-browser:integration": "node scripts/test-posting-quota.mjs --browser",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "@vitest/coverage-v8": "^4.1.11",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "express": "4.22.2",
    "mongodb": "^6.20.0",
    "qs": "6.16.0"
  },
  "overrides": {
    "qs": "$qs"
  }
}
