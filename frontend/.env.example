REACT_APP_BACKEND_URL=http://localhost:4000
# New-create rollout only: legacy (default, manual review) or core (AI review).
# Use the Gateway URL above. Deploy compatible servers/consumers before enabling
# core and rebuild the frontend. Saved attempts always retain their writer/key;
# switching this flag is NOT a way to reroute or clear pending requests.
REACT_APP_JOB_CREATE_MODE=legacy
# Independent read/edit rollout. Pending Core edits stay Core on refresh even
# if this flag is disabled; keep Core online for read-only reconciliation.
REACT_APP_JOB_EDIT_MODE=legacy
REACT_APP_CONTACT_EMAIL=
