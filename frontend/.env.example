REACT_APP_BACKEND_URL=http://localhost:4000
# New-create rollout only: legacy (default, manual review) or core (AI review).
# Use the Gateway URL above. Deploy compatible servers/consumers before enabling
# core and rebuild the frontend. Saved attempts always retain their writer/key;
# switching this flag is NOT a way to reroute or clear pending requests.
REACT_APP_JOB_CREATE_MODE=legacy
# Independent read/edit rollout. Pending Core edits stay Core on refresh even
# if this flag is disabled; keep Core online for read-only reconciliation.
REACT_APP_JOB_EDIT_MODE=legacy
# Independent repost rollout. Stored legacy/Core attempts keep their original
# writer/key/source revision/deadline in every state, including after rollback.
# Keep both endpoints available for explicit receipt lookup; never auto-fallback.
REACT_APP_JOB_REPOST_MODE=legacy
# Recruiter list + moderation information, read-only; ADMIN remains legacy.
# Deploy new Job Core + Gateway workspace routes before enabling and rebuilding.
# Independent of create/edit/repost flags; errors never fall back to public APIs.
REACT_APP_JOB_WORKSPACE_MODE=legacy
# Public search: deploy Search + Gateway multi-value query contracts first.
REACT_APP_JOB_SEARCH_MODE=legacy
# Candidate CV/AI entry points; existing task IDs remain readable on rollback.
REACT_APP_CANDIDATE_AI_ENABLED=false
# Candidate application stages; deploy Application + Gateway before enabling.
REACT_APP_APPLICATION_PROGRESS_ENABLED=false
# Select a saved structured CV, review a PDF, then explicitly submit via legacy.
REACT_APP_PREPARED_CV_APPLICATION_ENABLED=false
REACT_APP_CONTACT_EMAIL=
