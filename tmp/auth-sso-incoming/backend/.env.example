# Server
PORT=5000
NODE_ENV=development
URL_REACT=http://localhost:3000
# Keep false locally to disable automatic recommendation emails and daily CV quota resets.
# When omitted, scheduled jobs remain enabled for compatibility with existing deployments.
SCHEDULED_JOBS_ENABLED=false

# MySQL/MariaDB (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3333
DB_NAME=jobfindtest
DB_USER=root
DB_PASSWORD=

# Use a long random value. Keep it identical to microservices/JWT_SECRET.
JWT_SECRET=
JWT_ISSUER=jobfind-auth
JWT_AUDIENCE=jobfind-api
JWT_ACCESS_TTL_SECONDS=900

# Optional email delivery (Gmail App Password)
EMAIL_APP=
EMAIL_APP_PASSWORD=

# Optional Cloudinary uploads
CLOUD_NAME=
API_KEY=
API_SECRET=

# Optional PayPal Sandbox payments
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYMENT_INTENT_TTL_MINUTES=30

# Use a separate long random value. Keep it identical to microservices/INTERNAL_SECRET.
INTERNAL_SECRET=replace-with-a-shared-internal-secret

# Event publishing to the Docker RabbitMQ instance
RABBITMQ_URL=amqp://jobportal:replace-with-a-random-password@localhost:5673

# Realtime: omit SOCKET_REDIS_URL for a single backend instance.
# Multiple instances require the same private Redis plus sticky routing for polling.
# SOCKET_REDIS_URL=redis://127.0.0.1:6379
SOCKET_LOG_EVENTS=false

# Distinct for every environment; identical across nodes of the same environment.
SOCKET_REDIS_PREFIX=jobfind
# Direct peer connection attempts/minute; tune with ingress per-IP limiting.
SOCKET_HANDSHAKE_LIMIT_PER_MINUTE=120
# Optional OTLP/HTTP tracing. No message text, token or participant IDs exported.
SOCKET_TRACING_ENABLED=false
OTEL_SERVICE_NAME=jobfind-realtime
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Web Push is opt-in. Apply migrationzzzzzz-web-push.js before enabling.
WEB_PUSH_ENABLED=false
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# JobFind AI assistant: server-side only. Never expose in REACT_APP_*.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Server-side session rotation and Google OpenID Connect. Run the additive auth migration first.
# Production disallows older JWTs without a server-side session by default.
AUTH_ALLOW_LEGACY_TOKENS=false
OIDC_GOOGLE_ENABLED=false
OIDC_GOOGLE_ISSUER=https://accounts.google.com
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
# Exact PUBLIC API Gateway URL registered with Google OAuth (not internal backend :5000).
OIDC_GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/sso/google/callback
