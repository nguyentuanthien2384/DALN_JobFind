# ============================================================
# DALN JobFind — .gitignore
# Mục tiêu: loại trừ mọi file được sinh tự động / nặng / nhạy cảm
# mà không ảnh hưởng đến khả năng chạy dự án khi clone về.
# ============================================================

# --------------------------------------------------
# 1. Dependencies — thư mục nặng nhất, cài lại bằng `npm install`
# --------------------------------------------------
node_modules/
**/node_modules/
jspm_packages/
web_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# --------------------------------------------------
# 2. Build outputs — được tạo lại bằng `npm run build`
# --------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/

# --------------------------------------------------
# 3. Test coverage — được tạo lại bằng `npm run test:coverage`
# --------------------------------------------------
coverage/
**/coverage/
*.lcov
.nyc_output/

# --------------------------------------------------
# 4. Thư mục làm việc cục bộ — logs, screenshots, kết quả test
#    Không cần thiết cho người khác clone về
# --------------------------------------------------
.local/
**/.local/

# --------------------------------------------------
# 5. Environment & Secrets — chứa thông tin nhạy cảm
#    Giữ lại .env.example và frontend/.env.test làm mẫu
# --------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.sample
**/.env
**/.env.*
!**/.env.example
!frontend/.env.test
**/.secrets/

# --------------------------------------------------
# 6. Logs — file ghi log được sinh ra khi chạy/test
# --------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------
# 7. Runtime / temp files — file tạm khi chạy ứng dụng
# --------------------------------------------------
*.pid
*.seed
*.pid.lock
*.lock
!package-lock.json
!**/package-lock.json
*.tmp
*.temp
*.swp
*.swo

# --------------------------------------------------
# 8. OS-specific files
# --------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# --------------------------------------------------
# 9. IDE / Editor files
# --------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# --------------------------------------------------
# 10. File nén — tránh đẩy các bản release/backup nặng
# --------------------------------------------------
*.zip
*.tar.gz
*.rar
*.7z
*.tar
*.gz
*.tgz

# --------------------------------------------------
# 11. Docker — file tạm của Docker (giữ docker-compose.yml)
# --------------------------------------------------
docker-compose.override.yml
.docker/

# --------------------------------------------------
# 12. Uploads — file user upload khi chạy local
# --------------------------------------------------
uploads/
**/uploads/
