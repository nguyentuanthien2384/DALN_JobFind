# ============================================================
# DALN JobFind — .gitignore
# Mục tiêu: loại trừ mọi file được sinh tự động / nặng / nhạy cảm
# mà không ảnh hưởng đến khả năng chạy dự án khi clone về.
# ============================================================

# --------------------------------------------------
# 1. Dependencies — thư mục nặng nhất, cài lại bằng `npm install`
# --------------------------------------------------
node_modules/
jspm_packages/
web_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.npm/
.pnpm-store/

# --------------------------------------------------
# 2. Build outputs — được tạo lại bằng `npm run build`
# --------------------------------------------------
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Source maps của thư viện giao diện chỉ phục vụ debug, không cần để chạy.
# Giữ các file CSS/JS, ảnh và font trong public/.
/frontend/public/**/*.css.map
/frontend/public/**/*.js.map
# PDF.js trong frontend/public/pdfjs/ được tạo lại khi start/build;
# thư mục này đã có .gitignore riêng.

# --------------------------------------------------
# 3. Test coverage — được tạo lại bằng `npm run test:coverage`
# --------------------------------------------------
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --------------------------------------------------
# 4. Thư mục làm việc cục bộ — logs, screenshots, kết quả test
#    Không cần thiết cho người khác clone về
# --------------------------------------------------
.local/

# File trung gian do backend/scripts/sync-sql-dump.js tạo.
# Giữ database/jobfindtest.sql để người clone có dữ liệu mẫu.
/database/sync-append.sql

# --------------------------------------------------
# 5. Environment & Secrets — chứa thông tin nhạy cảm
#    Giữ lại cấu hình mẫu và frontend/.env.test cho kiểm thử
# --------------------------------------------------
.env
.env.*
!**/.env.example
!**/.env.*.example
!**/.env.sample
!**/.env.*.sample
!**/.env.template
!**/.env.*.template
!frontend/.env.test
.secrets/

# --------------------------------------------------
# 6. Logs — file ghi log được sinh ra khi chạy/test
# --------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------
# 7. Runtime / temp files — file tạm khi chạy ứng dụng
# --------------------------------------------------
*.pid
*.seed
*.pid.lock
# Không dùng *.lock: cần giữ package-lock.json, yarn.lock, pnpm-lock.yaml.
*.tmp
*.temp
*.swp
*.swo

# --------------------------------------------------
# 8. OS-specific files
# --------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# --------------------------------------------------
# 9. IDE / Editor files
# --------------------------------------------------
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.sw?
.project
.classpath
.settings/

# --------------------------------------------------
# 10. File nén — tránh đẩy các bản release/backup nặng
# --------------------------------------------------
*.zip
*.tar.gz
*.rar
*.7z
*.tar
*.gz
*.tgz

# --------------------------------------------------
# 11. Docker — file tạm của Docker (giữ docker-compose.yml)
# --------------------------------------------------
docker-compose.override.yml
.docker/

# --------------------------------------------------
# 12. Uploads — file user upload khi chạy local
# --------------------------------------------------
uploads/

# Luôn giữ mã nguồn, scripts setup/build, migrations/seeders, fixtures,
# package.json/lockfiles, Docker/Compose, .github, tài liệu và public assets.
# Không bỏ qua toàn bộ database/, tests/, frontend/public/ hoặc assetsAdmin/.
