{
  "name": "jobfind",
  "private": true,
  "scripts": {
    "start": "node scripts/dev.mjs start",
    "dev": "node scripts/dev.mjs start",
    "dev:status": "node scripts/dev.mjs status",
    "dev:stop": "node scripts/dev.mjs stop",
    "dev:check": "node scripts/check-live-data.mjs",
    "test:runtime": "node --test scripts/*.test.mjs",
    "test:restore": "node scripts/restore-drill.mjs --source-project ai-job-portal",
    "test": "npm run test:unit",
    "test:unit": "npm run test:backend && npm run test:frontend && npm run test:microservices",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend run test:unit",
    "test:microservices": "npm --prefix microservices test",
    "test:coverage": "npm run coverage:backend && npm run coverage:frontend && npm run coverage:microservices",
    "coverage:backend": "npm --prefix backend run test:coverage",
    "coverage:frontend": "npm --prefix frontend run test:coverage",
    "coverage:microservices": "npm --prefix microservices run test:coverage"
  }
}
