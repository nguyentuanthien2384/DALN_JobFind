# Cau hinh JobFind tren VPS. Cach nhanh nhat: tren may dev chay
#   npm run vps:env -- jobfind.example.com
# de tao deploy/.env (sinh mat khau moi, chep khoa AI/email/Cloudinary... tu .env local).
# Hoac chep file nay thanh deploy/.env roi tu dien. KHONG commit deploy/.env.
#
# Gia tri co dau cach, #, $ hoac dau nhay: dat trong nhay don, vd EMAIL_APP_PASSWORD='abcd efgh ijkl mnop'

# ============ TEN MIEN ============
# Ten mien da tro ban ghi A ve IP cua VPS. Caddy tu xin chung chi HTTPS.
SITE_ADDRESS=jobfind.example.com
PUBLIC_URL=https://jobfind.example.com
# Chua co ten mien: SITE_ADDRESS=:80 va PUBLIC_URL=http://<IP-VPS>. Chi de xem thu:
# khong co HTTPS thi trinh duyet khong luu cookie phien (Secure), dang nhap khong ben.
# HTTP_PORT=80
# HTTPS_PORT=443

# ============ MAT KHAU VA KHOA BI MAT (bat buoc) ============
# Chi dung chu cai va chu so (mat khau nam trong URL ket noi). Sinh: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# It nhat 32 ky tu; INTERNAL_SECRET phai khac JWT_SECRET.
JWT_SECRET=
INTERNAL_SECRET=

# Ten CSDL va tai khoan dich vu (thuong de nguyen).
MYSQL_DATABASE=jobfindtest
MYSQL_USER=jobfind
POSTGRES_USER=jobfind
RABBITMQ_USER=jobfind

# ============ AI ============
# "ai" bat AI Worker (sang loc CV, goi y...). Bo trong neu khong co ANTHROPIC_API_KEY.
COMPOSE_PROFILES=ai
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
SUPPORT_CLAUDE_MODEL=claude-sonnet-5
# Du phong cho chatbot khi khong co Claude.
GEMINI_API_KEY=
OPENAI_API_KEY=

# ============ EMAIL (Gmail App Password) ============
# Production bo qua dia chi mau (@example...) thay vi gui.
EMAIL_APP=
EMAIL_APP_PASSWORD=

# ============ UPLOAD ANH (Cloudinary) ============
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============ THANH TOAN SANDBOX (PayPal / ZaloPay / MoMo / VNPAY) ============
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ZaloPay Merchant Trial V2 (the ATM test: 9704540000000062, NGUYEN VAN A, 10/18)
ZALOPAY_APP_ID=2554
ZALOPAY_KEY1=sdngKKJmqEMzvh5QQcdD2A9XBSKUNaYn
ZALOPAY_KEY2=trMrHtvjo6myautxDUiAcYsVtaeQ8nhf
ZALOPAY_CREATE_URL=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_QUERY_URL=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_PREFERRED_METHODS=domestic_card,account
# MoMo Sandbox (payWithMethod - the ATM NAPAS test: 9704000000000018, NGUYEN VAN A, 03/07, OTP 000000)
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REQUEST_TYPE=payWithMethod
# VNPAY Sandbox (dang ky VNP_TMN_CODE & VNP_HASH_SECRET mien phi tai https://sandbox.vnpayment.vn/devreg/)
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_DEFAULT_BANK_CODE=

# ============ WEB PUSH ============
# Tao cap khoa: npm --prefix backend run push:keys
WEB_PUSH_ENABLED=false
WEB_PUSH_SUBJECT=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# ============ DANG NHAP GOOGLE / GITHUB / AUTH0 ============
# Dang ky redirect URI <PUBLIC_URL>/api/auth/sso/google/callback (va .../github/callback, .../auth0/callback)
# o Google Cloud Console / GitHub / Auth0 (Allowed Callback URLs) truoc khi bat.
OIDC_GOOGLE_ENABLED=false
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Auth0 Regular Web Application; issuer giu dau / cuoi, vd https://TENANT.us.auth0.com/
OIDC_AUTH0_ENABLED=false
OIDC_AUTH0_ISSUER=
OIDC_AUTH0_CLIENT_ID=
OIDC_AUTH0_CLIENT_SECRET=
# Nut Google/GitHub/Facebook di qua cac connection Auth0 nay, vd google-oauth2,github,facebook
# Can HTTPS (ten mien). Sau khi deploy: npm run vps:check-sso -- <PUBLIC_URL> (xem deploy/README.md muc 6).
OIDC_AUTH0_CONNECTIONS=

# ============ TAC VU DINH KY CUA BACKEND ============
# true: gui email goi y viec lam tu dong, reset han muc xem CV hang ngay, doi soat PayPal.
# Du lieu demo co nhieu email mau: chi bat khi da dung du lieu that.
SCHEDULED_JOBS_ENABLED=false

# ============ CO GIAO DIEN (dong vao bundle, doi phai build lai web) ============
REACT_APP_JOB_CREATE_MODE=core
REACT_APP_JOB_EDIT_MODE=core
REACT_APP_JOB_REPOST_MODE=core
REACT_APP_JOB_WORKSPACE_MODE=core
REACT_APP_JOB_SEARCH_MODE=core
REACT_APP_CANDIDATE_AI_ENABLED=true
REACT_APP_APPLICATION_PROGRESS_ENABLED=true
REACT_APP_PREPARED_CV_APPLICATION_ENABLED=false
REACT_APP_CONTACT_EMAIL=

# ============ IMAGE (khi build tren may khac roi day len VPS) ============
# JOBFIND_IMAGE_PREFIX=jobfind
# JOBFIND_TAG=latest
