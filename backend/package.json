{
  "name": "jobfindapi",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "start": "babel-node src/server.js",
    "dev": "nodemon --exec babel-node src/server.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:smoke:entitlement": "babel-node scripts/smoke-entitlement.js",
    "test:candidate-search": "node scripts/test-candidate-search.cjs",
    "test:candidate-search:browser": "node scripts/test-candidate-search-browser.cjs",
    "restore:sample-data": "node scripts/restore-sample-data.js",
    "seed:test-accounts": "node scripts/create-test-accounts.js",
    "seed:demo-data": "node scripts/setup-demo-data.js",
    "test:chat:infrastructure": "node scripts/test-chat-infrastructure.cjs",
    "test:support-chat": "jest --runInBand --runTestsByPath tests/services/supportChatService.test.cjs tests/services/supportJobTools.test.cjs tests/services/supportToolCalling.test.cjs tests/services/supportReadiness.test.cjs",
    "test:support-chat:browser": "node scripts/test-support-chat-browser.cjs",
    "test:support-chat:live": "node scripts/evaluate-support-chat.cjs",
    "push:keys": "node scripts/generate-push-keys.cjs",
    "test:push:browser": "node scripts/realtime/push-browser.cjs"
  },
  "author": "bingo2706",
  "license": "ISC",
  "jest": {
    "testEnvironment": "node",
    "clearMocks": true,
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "collectCoverageFrom": [
      "src/controllers/**/*.js",
      "src/services/**/*.js",
      "src/middlewares/**/*.js",
      "src/utils/**/*.js",
      "src/config/connectDB.js",
      "src/config/socket.js",
      "src/config/viewEngine.js",
      "src/routes/web.js",
      "src/server.js",
      "!src/utils/cloudinary.js"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "dependencies": {
    "@babel/core": "^7.26.10",
    "@babel/node": "^7.26.0",
    "@babel/preset-env": "^7.26.9",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "amqplib": "^0.10.4",
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cloudinary": "^2.6.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "keyword-extractor": "^0.0.28",
    "mysql2": "^3.14.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^9.0.6",
    "openid-client": "6.8.8",
    "paypal-rest-sdk": "^1.8.1",
    "pdf.js-extract": "^0.2.1",
    "redis": "^6.2.1",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "babel-jest": "^30.5.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.0",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2",
    "socket.io-client": "^4.8.3"
  },
  "overrides": {
    "sequelize": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
