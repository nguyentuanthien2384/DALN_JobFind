{
  "_comment": "Mutation testing for security and payment code: line coverage cannot show whether a check is actually asserted. Run with npm run test:mutation.",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "stryker.jest.config.cjs",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/middlewares/rateLimit.js",
    "src/utils/otpStore.js"
  ],
  "ignorePatterns": [
    "coverage",
    "reports",
    "scripts",
    "*.log",
    "api",
    "vendor"
  ],
  "reporters": [
    "clear-text",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/experiment-on.json"
  },
  "thresholds": {
    "high": 92,
    "low": 85,
    "break": null
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "tempDirName": ".stryker-tmp"
}