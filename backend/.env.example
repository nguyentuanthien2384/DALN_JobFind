# Server
PORT=5000
NODE_ENV=development
URL_REACT=http://localhost:3000

# MySQL/MariaDB (XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3333
DB_NAME=jobfindtest
DB_USER=root
DB_PASSWORD=

# Use a long random value. Keep it identical to microservices/JWT_SECRET.
JWT_SECRET=
JWT_ISSUER=jobfind-auth
JWT_AUDIENCE=jobfind-api
JWT_ACCESS_TTL_SECONDS=900

# Optional email delivery (Gmail App Password)
EMAIL_APP=
EMAIL_APP_PASSWORD=

# Optional Cloudinary uploads
CLOUD_NAME=
API_KEY=
API_SECRET=

# Optional PayPal Sandbox payments
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYMENT_INTENT_TTL_MINUTES=30

# Use a separate long random value. Keep it identical to microservices/INTERNAL_SECRET.
INTERNAL_SECRET=replace-with-a-shared-internal-secret

# Event publishing to the Docker RabbitMQ instance
RABBITMQ_URL=amqp://jobportal:replace-with-a-random-password@localhost:5673
